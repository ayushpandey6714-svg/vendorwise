# Copy to .env. Fixture mode is explicit; arbitrary PDFs need live mode.
VENDORWISE_MODE=fixture
# For real AI with your OpenRouter key: set VENDORWISE_MODE=live.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-key-here
OPENROUTER_MODEL=openrouter/free
# Alternative: LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
VENDORWISE_PUBLIC_DEMO=false
# Shared limits count every AI request, including failed attempts and Q&A steps.
VENDORWISE_AI_REQUESTS_PER_MINUTE=20
VENDORWISE_AI_REQUESTS_PER_DAY=100
VENDORWISE_MAX_ANALYSES=50
# fastembed = real local semantic embeddings, first-run model download.
# tfidf = explicitly labelled local lexical vector baseline, no model download.
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional alternative; only used when LLM_PROVIDER=openai.
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
VENDORWISE_API_URL=http://127.0.0.1:8000
# Optional absolute local directory controlled by the server operator:
# VENDORWISE_DATA_DIR=C:/path/to/vendorwise/data
